---
const currentPath = Astro.url.pathname;

const navLinks = [
	{ name: 'Game Reviews', href: '/category/game-reviews/' },
	{ name: 'App Reviews', href: '/category/app-reviews/' },
	{ name: 'Game Guides', href: '/category/game-guides/' },
	{ name: 'App Tips', href: '/category/app-tips/' },
	{ name: 'Comparisons', href: '/category/comparisons/' },
	{ name: 'News', href: '/category/news/' },
	{ name: 'Best Picks', href: '/category/best-picks/' },
];
---

<header class="site-header">
	<div class="container header-container">
		<!-- Top Branding: Logo & Tagline -->
		<div class="brand-row">
			<a href="/" class="brand-link" aria-label="PanBloom Home">
				<div class="logo-wrapper">
					<span class="logo-main">PanBloom</span><span class="logo-sub">.com</span>
				</div>
				<p class="tagline">The Haven for iOS and Android Enthusiasts</p>
			</a>
		</div>

		<!-- Inline Navigation Links Aligned to Bottom -->
		<nav class="bottom-nav" aria-label="Main Navigation">
			<ul class="nav-links">
				{
					navLinks.map((item) => (
						<li>
							<a
								href={item.href}
								class={`nav-item ${currentPath === item.href ? 'active' : ''}`}
							>
								{item.name}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>

<style>
	.site-header {
		background-color: var(--color-header-bg);
		color: #ffffff;
		border-bottom: 1px solid var(--color-header-border);
		width: 100%;
	}

	.header-container {
		display: flex;
		flex-direction: column;
		padding-top: 1.25rem;
		padding-bottom: 0.85rem;
		gap: 1.25rem;
	}

	.brand-row {
		display: flex;
		align-items: flex-start;
	}

	.brand-link {
		text-decoration: none;
		display: inline-block;
	}

	.logo-wrapper {
		display: flex;
		align-items: baseline;
		line-height: 1;
	}

	.logo-main {
		font-size: 1.6rem;
		font-weight: 800;
		color: #ffffff;
		letter-spacing: -0.03em;
	}

	.logo-sub {
		font-size: 1.6rem;
		font-weight: 700;
		color: #e5e7eb;
		letter-spacing: -0.03em;
	}

	.tagline {
		margin: 0.35rem 0 0;
		font-size: 0.75rem;
		color: #9ca3af;
		letter-spacing: 0.01em;
		font-weight: 400;
	}

	.bottom-nav {
		width: 100%;
		overflow-x: auto;
		scrollbar-width: none;
	}

	.bottom-nav::-webkit-scrollbar {
		display: none;
	}

	.nav-links {
		display: flex;
		align-items: center;
		list-style: none;
		margin: 0;
		padding: 0;
		gap: 1.75rem;
		white-space: nowrap;
	}

	.nav-item {
		font-size: 0.875rem;
		font-weight: 500;
		color: #e5e7eb;
		text-decoration: none;
		transition: color 0.15s ease;
		display: inline-block;
		padding-bottom: 0.2rem;
	}

	.nav-item:hover {
		color: #ffffff;
		text-decoration: none;
	}

	.nav-item.active {
		color: #ffffff;
		border-bottom: 2px solid var(--color-badge-blue);
		padding-bottom: 0.1rem;
	}

	@media (max-width: 768px) {
		.header-container {
			gap: 1rem;
			padding-top: 1rem;
		}

		.nav-links {
			gap: 1.25rem;
		}
	}
</style>
