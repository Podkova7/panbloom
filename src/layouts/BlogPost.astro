---
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getAuthorByName } from '../data/authors';

type Props = CollectionEntry<'blog'>['data'] & {
	currentPost?: CollectionEntry<'blog'>;
};

const { title, description, pubDate, updatedDate, heroImage, currentPost } = Astro.props;
const category = (Astro.props as any).category || 'App Reviews';
const categorySlug = category.toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const author = (Astro.props as any).author || 'PanBloom Team';
const authorSlug = author.toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

const authorObj = getAuthorByName(author);

// Query related articles
const allPosts = await getCollection('blog');
const currentId = currentPost ? currentPost.id : '';

// 1. Same category posts (excluding current)
const sameCategoryPosts = allPosts
	.filter((p) => p.id !== currentId && ((p.data as any).category || '') === category)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// 2. Fallback other category posts (excluding current)
const otherPosts = allPosts
	.filter((p) => p.id !== currentId && ((p.data as any).category || '') !== category)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// 3. Related articles for 3-column grid (top 3)
// 3. Related articles for 3-column grid (top 3)
const relatedArticles = [...sameCategoryPosts, ...otherPosts].slice(0, 3);

// 4. Related guide links for the in-post callout box (up to 5 links)
const relatedGuideLinks = [...sameCategoryPosts, ...otherPosts].slice(0, 5);

// Schema.org structured data for High E-E-A-T and Search Quality Raters
const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'TechArticle',
	headline: title,
	description: description,
	image: heroImage ? [new URL(typeof heroImage === 'string' ? heroImage : heroImage.src, Astro.site).href] : [],
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate || pubDate).toISOString(),
	author: {
		'@type': 'Person',
		name: author,
		url: new URL(`/author/${authorSlug}/`, Astro.site).href,
		jobTitle: authorObj ? authorObj.role : 'Tech Writer & Analyst',
	},
	publisher: {
		'@type': 'Organization',
		name: 'PanBloom',
		legalName: 'SATMAT DIGITAL LTD',
		url: 'https://panbloom.com',
		logo: {
			'@type': 'ImageObject',
			url: 'https://panbloom.com/favicon.svg',
		},
	},
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': Astro.url.href,
	},
};

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: 'Home',
			item: 'https://panbloom.com/',
		},
		{
			'@type': 'ListItem',
			position: 2,
			name: category,
			item: new URL(`/category/${categorySlug}/`, Astro.site).href,
		},
		{
			'@type': 'ListItem',
			position: 3,
			name: title,
			item: Astro.url.href,
		},
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} | PanBloom.com`} description={description} image={heroImage} />
		<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
	</head>
	<body>
		<Header />
		<main class="main-content">
			<article class="article-container">
				<div class="container article-inner">
					<!-- Breadcrumb & Category -->
					<div class="article-eyebrow-row">
						<a href="/" class="back-link">&larr; Back to Home</a>
						<a href={`/category/${categorySlug}/`} class="category-pill">{category}</a>
					</div>

					<header class="article-header">
						<h1 class="article-title">{title}</h1>
						<p class="article-lead">{description}</p>

						<div class="article-byline">
							<div class="author-meta">
								<span class="by-text">By</span>
								<a href={`/author/${authorSlug}/`} class="author-name">{author}</a>
								<span class="dot-sep">&bull;</span>
								<span class="date-text">
									Published <FormattedDate date={pubDate} />
								</span>
								{
									updatedDate && (
										<span class="last-updated">
											(Updated <FormattedDate date={updatedDate} />)
										</span>
									)
								}
							</div>
						</div>
					</header>

					<!-- Hero Visual -->
					{
						heroImage && (
							<div class="hero-image-wrapper">
								{typeof heroImage === 'string' ? (
									<img
										src={heroImage}
										alt={title}
										width="1280"
										height="720"
										class="hero-image"
									/>
								) : (
									<Image
										src={heroImage}
										alt={title}
										width={1280}
										height={720}
										class="hero-image"
									/>
								)}
							</div>
						)
					}

					<!-- Content Body -->
					<div class="prose-content">
						<slot />
					</div>

					<!-- Related Guides Callout Box (as shown in reference image) -->
					{
						relatedGuideLinks.length > 0 && (
							<div class="related-guides-box">
								<span class="rgb-kicker">FURTHER READING</span>
								<h3 class="rgb-title">Related {category} Guides</h3>
								<p class="rgb-subtitle">Recommended walkthroughs and deep-dive analyses from our editorial team:</p>
								<ul class="rgb-list">
									{
										relatedGuideLinks.map((guide) => (
											<li class="rgb-item">
												<a href={`/blog/${guide.id}/`} class="rgb-link">
													{guide.data.title}
												</a>
											</li>
										))
									}
								</ul>
								<div class="rgb-footer">
									<svg class="rgb-badge-icon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
										<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
									</svg>
									<span>PanBloom Tested &amp; Verified Guide</span>
								</div>
							</div>
						)
					}

					<!-- Editorial Trust Bar (as shown in reference image) -->
					<div class="article-trust-bar">
						<span class="trust-item"><a href="/editorial-policy/">Editorial Policy</a></span>
						<span class="trust-dot">&bull;</span>
						<span class="trust-item"><a href="/editorial-policy/">How We Review</a></span>
						<span class="trust-dot">&bull;</span>
						<span class="trust-item"><a href="/editorial-policy/">Affiliate Disclosure</a></span>
						<span class="trust-dot">&bull;</span>
						<span class="trust-item"><a href="/contact/">Contact Us</a></span>
					</div>
				</div>
			</article>

			<!-- Related Articles Section (Full Container Width with 3-Column Grid) -->
			{
				relatedArticles.length > 0 && (
					<section class="related-section">
						<div class="container">
							<div class="related-header">
								<h2 class="related-title">Related Articles</h2>
							</div>
							<div class="related-grid">
								{
									relatedArticles.map((relPost) => (
										<ArticleCard post={relPost} />
									))
								}
							</div>
						</div>
					</section>
				)
			}
		</main>
		<Footer />
	</body>
</html>

<style>
	.article-container {
		padding: 2.5rem 0 3.5rem;
	}

	.article-inner {
		max-width: 860px;
	}

	.article-eyebrow-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 1.5rem;
	}

	.back-link {
		color: var(--color-blue-primary);
		font-size: 0.875rem;
		font-weight: 600;
	}

	.category-pill {
		background: #eff6ff;
		color: #1d4ed8;
		border: 1px solid #dbeafe;
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		padding: 0.25rem 0.75rem;
		border-radius: var(--radius-full);
	}

	.article-header {
		margin-bottom: 2rem;
	}

	.article-title {
		font-size: 2.5rem;
		font-weight: 800;
		line-height: 1.2;
		color: var(--color-text-dark);
		letter-spacing: -0.025em;
		margin: 0 0 1rem 0;
	}

	@media (max-width: 768px) {
		.article-title {
			font-size: 2rem;
		}
	}

	.article-lead {
		font-size: 1.15rem;
		line-height: 1.6;
		color: var(--color-text-muted);
		margin-bottom: 1.5rem;
	}

	.article-byline {
		display: flex;
		align-items: center;
		padding: 1rem 0;
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
		font-size: 0.875rem;
		color: var(--color-text-muted);
	}

	.author-meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.35rem;
	}

	.author-name {
		font-weight: 700;
		color: var(--color-blue-primary);
		text-decoration: none;
	}

	.author-name:hover {
		text-decoration: underline;
	}

	.dot-sep {
		color: #94a3b8;
		margin: 0 0.25rem;
	}

	.hero-image-wrapper {
		margin-bottom: 2.5rem;
		border-radius: var(--radius-lg);
		overflow: hidden;
		box-shadow: var(--shadow-md);
		border: 1px solid var(--color-border);
	}

	.hero-image {
		width: 100%;
		height: auto;
		display: block;
	}

	.prose-content {
		font-size: 1.125rem;
		line-height: 1.8;
		color: #334155;
	}

	.prose-content :global(h2) {
		font-size: 1.75rem;
		margin: 2.5rem 0 1rem;
		color: var(--color-text-dark);
	}

	.prose-content :global(h3) {
		font-size: 1.35rem;
		margin: 2rem 0 0.75rem;
		color: var(--color-text-dark);
	}

	.prose-content :global(p) {
		margin-bottom: 1.5rem;
	}

	.prose-content :global(ul),
	.prose-content :global(ol) {
		margin-bottom: 1.5rem;
		padding-left: 1.5rem;
	}

	.prose-content :global(li) {
		margin-bottom: 0.5rem;
	}

	/* Related Guides Callout Box (as shown in reference image) */
	.related-guides-box {
		margin-top: 3.5rem;
		margin-bottom: 2rem;
		padding: 2rem 2.25rem;
		background: #f0f7ff;
		border: 1px solid #bfdbfe;
		border-radius: 12px;
	}

	.rgb-kicker {
		display: block;
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #2563eb;
		margin-bottom: 0.35rem;
	}

	.rgb-title {
		font-size: 1.25rem;
		font-weight: 800;
		color: #0f172a;
		margin: 0 0 0.45rem 0;
		line-height: 1.3;
	}

	.rgb-subtitle {
		font-size: 0.925rem;
		color: #475569;
		margin: 0 0 1.25rem 0;
		line-height: 1.5;
	}

	.rgb-list {
		list-style: none;
		padding: 0;
		margin: 0 0 1.5rem 0;
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
	}

	.rgb-item {
		position: relative;
		padding-left: 1.25rem;
		font-size: 0.975rem;
		line-height: 1.5;
	}

	.rgb-item::before {
		content: "•";
		position: absolute;
		left: 0;
		color: #2563eb;
		font-size: 1.25rem;
		line-height: 1;
		top: 1px;
	}

	.rgb-link {
		color: #1d4ed8;
		font-weight: 600;
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.rgb-link:hover {
		color: #1e40af;
		text-decoration: underline;
	}

	.rgb-footer {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.825rem;
		font-weight: 600;
		color: #0284c7;
		border-top: 1px solid #dbeafe;
		padding-top: 0.85rem;
	}

	.rgb-badge-icon {
		color: #0284c7;
		flex-shrink: 0;
	}

	@media (max-width: 640px) {
		.related-guides-box {
			padding: 1.25rem 1.25rem;
		}
	}

	/* Article Trust Bar */
	.article-trust-bar {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin: 2.25rem 0 1.5rem 0;
		font-size: 0.825rem;
		color: #94a3b8;
		text-align: center;
	}

	.trust-item a {
		color: #64748b;
		text-decoration: none;
		font-weight: 500;
		transition: color 0.15s ease;
	}

	.trust-item a:hover {
		color: #2563eb;
		text-decoration: underline;
	}

	.trust-dot {
		color: #cbd5e1;
		font-size: 0.75rem;
	}

	/* Related Articles Full-Width Section */
	.related-section {
		background-color: #ffffff;
		border-top: 1px solid var(--color-border);
		padding: 3.5rem 0 5rem;
	}

	.related-header {
		margin-bottom: 2rem;
	}

	.related-title {
		font-size: 1.85rem;
		font-weight: 800;
		color: var(--color-text-main);
		margin: 0;
		letter-spacing: -0.02em;
	}

	.related-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2rem;
	}

	@media (min-width: 768px) {
		.related-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 1024px) {
		.related-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>
