---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Contact Us | PanBloom.com"
	description="Contact the PanBloom.com editorial team for review inquiries, game pitches, corrections, or advertising."
>
	<div class="policy-page">
		<div class="container policy-container">
			<header class="policy-header">
				<span class="policy-eyebrow">Get in Touch</span>
				<h1 class="policy-title">Contact the Editorial Team</h1>
				<p class="policy-meta">We typically respond to editorial and business queries within 1–2 business days.</p>
			</header>

			<div class="policy-content">
				<div class="contact-grid">
					<div class="contact-card">
						<h3>Editorial &amp; Review Pitches</h3>
						<p>Are you an indie developer or studio releasing a new mobile title or major update?</p>
						<a href="mailto:editorial@panbloom.com" class="contact-email">editorial@panbloom.com</a>
					</div>

					<div class="contact-card">
						<h3>Corrections &amp; Feedback</h3>
						<p>Found a broken link, outdated guide step, or incorrect specification in one of our teardowns?</p>
						<a href="mailto:corrections@panbloom.com" class="contact-email">corrections@panbloom.com</a>
					</div>

					<div class="contact-card">
						<h3>Advertising &amp; Partnerships</h3>
						<p>Inquiries regarding direct programmatic advertising and partnership opportunities.</p>
						<a href="mailto:advertising@panbloom.com" class="contact-email">advertising@panbloom.com</a>
					</div>

					<div class="contact-card">
						<h3>Corporate &amp; Registered Office</h3>
						<p>
							<strong>SATMAT DIGITAL LTD</strong><br />
							308 St. Pauls Road<br />
							London, England N1 2LF<br />
							<span style="font-size: 0.8rem; color: var(--color-text-muted);">Registered in England &amp; Wales &bull; SIC: 47910</span>
						</p>
						<a href="mailto:legal@panbloom.com" class="contact-email">legal@panbloom.com</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</BaseLayout>

<style>
	.policy-page {
		padding: 3.5rem 0 5rem;
	}
	.policy-container {
		max-width: 820px;
	}
	.policy-header {
		margin-bottom: 2.5rem;
		border-bottom: 1px solid var(--color-border);
		padding-bottom: 1.5rem;
	}
	.policy-eyebrow {
		font-size: 0.8125rem;
		font-weight: 700;
		color: var(--color-blue-primary);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		display: block;
		margin-bottom: 0.5rem;
	}
	.policy-title {
		font-size: 2.5rem;
		color: var(--color-text-dark);
		line-height: 1.2;
		margin: 0 0 0.75rem 0;
	}
	.policy-meta {
		color: var(--color-text-muted);
		font-size: 0.875rem;
		margin: 0;
	}
	.contact-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
	}
	@media (min-width: 640px) {
		.contact-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	.contact-card {
		background: #ffffff;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: 1.5rem;
		box-shadow: var(--shadow-sm);
	}
	.contact-card h3 {
		font-size: 1.15rem;
		margin: 0 0 0.5rem 0;
	}
	.contact-card p {
		font-size: 0.9rem;
		color: var(--color-text-muted);
		margin: 0 0 1rem 0;
		line-height: 1.5;
	}
	.contact-email {
		font-weight: 600;
		color: var(--color-blue-primary);
		text-decoration: underline;
		font-size: 0.95rem;
	}
</style>
