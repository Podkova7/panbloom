---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Terms of Use | PanBloom.com"
	description="PanBloom.com Terms of Use and Conditions."
>
	<div class="policy-page">
		<div class="container policy-container">
			<header class="policy-header">
				<span class="policy-eyebrow">Legal Agreement</span>
				<h1 class="policy-title">Terms and Conditions of Use</h1>
				<p class="policy-meta">Last Updated: September 2026</p>
			</header>

			<div class="policy-content">
				<section>
					<h2>1. Agreement to Terms &amp; Corporate Publisher</h2>
					<p>
						<strong>PanBloom.com</strong> is published and operated by <strong>SATMAT DIGITAL LTD</strong>, a private company limited by shares registered in England and Wales (Registered Office: 308 St. Pauls Road, London, England N1 2LF, SIC: 47910). By accessing or using PanBloom.com, you agree to be bound by these Terms of Use and all applicable laws and regulations. If you do not agree with any of these terms, you are prohibited from using or accessing this site.
					</p>
				</section>

				<section>
					<h2>2. Intellectual Property Rights</h2>
					<p>
						All original written content, scoring analyses, guides, and layouts on PanBloom.com are the intellectual property of PanBloom.com and protected by international copyright laws. App trademarks, brand names, and game screenshots remain the property of their respective holders and are used under fair use principles for journalistic critique and reporting.
					</p>
				</section>

				<section>
					<h2>3. Disclaimer of Warranties</h2>
					<p>
						The materials on PanBloom.com are provided on an "as is" basis. While we strive for rigorous accuracy, we make no warranties regarding software stability, third-party pricing changes, or app store availability.
					</p>
				</section>
			</div>
		</div>
	</div>
</BaseLayout>

<style>
	.policy-page {
		padding: 3.5rem 0 5rem;
	}
	.policy-container {
		max-width: 820px;
	}
	.policy-header {
		margin-bottom: 2.5rem;
		border-bottom: 1px solid var(--color-border);
		padding-bottom: 1.5rem;
	}
	.policy-eyebrow {
		font-size: 0.8125rem;
		font-weight: 700;
		color: var(--color-blue-primary);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		display: block;
		margin-bottom: 0.5rem;
	}
	.policy-title {
		font-size: 2.5rem;
		color: var(--color-text-dark);
		line-height: 1.2;
		margin: 0 0 0.75rem 0;
	}
	.policy-meta {
		color: var(--color-text-muted);
		font-size: 0.875rem;
		margin: 0;
	}
	.policy-content {
		color: #334155;
		font-size: 1.05rem;
		line-height: 1.75;
	}
	.policy-content section {
		margin-bottom: 2rem;
	}
	.policy-content h2 {
		font-size: 1.5rem;
		color: var(--color-text-dark);
		margin: 1.75rem 0 0.75rem 0;
	}
	.policy-content p {
		margin-bottom: 1.25rem;
	}
</style>
