---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Page Not Found (404) | PanBloom.com"
	description="The page you requested could not be found. Explore our latest mobile app reviews, guides, and tech analyses."
>
	<div class="error-page">
		<div class="container error-container">
			<div class="error-card">
				<span class="error-code">404</span>
				<h1 class="error-title">Page Not Found</h1>
				<p class="error-message">
					The article or resource you are looking for might have been moved, updated, or is temporarily unavailable.
				</p>

				<div class="error-actions">
					<a href="/" class="btn-primary">&larr; Return to Homepage</a>
					<a href="/authors/" class="btn-secondary">Meet Our Authors</a>
				</div>

				<div class="quick-links-section">
					<h2 class="quick-links-heading">Popular Categories</h2>
					<div class="quick-links-grid">
						<a href="/category/game-reviews/" class="category-link">Game Reviews</a>
						<a href="/category/app-reviews/" class="category-link">App Reviews</a>
						<a href="/category/game-guides/" class="category-link">Game Guides</a>
						<a href="/category/app-tips/" class="category-link">App Tips</a>
						<a href="/category/comparisons/" class="category-link">Comparisons</a>
						<a href="/category/best-picks/" class="category-link">Best Picks</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</BaseLayout>

<style>
	.error-page {
		padding: 4rem 0 6rem;
		min-height: 60vh;
		display: flex;
		align-items: center;
	}

	.error-container {
		max-width: 680px;
	}

	.error-card {
		text-align: center;
		background: #ffffff;
		border: 1px solid #e2e8f0;
		border-radius: 16px;
		padding: 3.5rem 2rem;
		box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -2px rgba(0, 0, 0, 0.05);
	}

	.error-code {
		display: inline-block;
		font-size: 4.5rem;
		font-weight: 800;
		color: #10141c;
		line-height: 1;
		margin-bottom: 0.5rem;
		letter-spacing: -0.04em;
	}

	.error-title {
		font-size: 1.85rem;
		font-weight: 700;
		color: var(--color-text-main);
		margin: 0 0 1rem 0;
	}

	.error-message {
		font-size: 1rem;
		color: var(--color-text-sub);
		line-height: 1.6;
		margin: 0 0 2rem 0;
	}

	.error-actions {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		flex-wrap: wrap;
		margin-bottom: 2.75rem;
	}

	.btn-primary {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.75rem 1.5rem;
		background-color: #10141c;
		color: #ffffff;
		border-radius: 10px;
		font-weight: 600;
		font-size: 0.95rem;
		text-decoration: none;
		transition: background-color 0.15s ease;
	}

	.btn-primary:hover {
		background-color: #1f2937;
		color: #ffffff;
	}

	.btn-secondary {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.75rem 1.5rem;
		background-color: #f8fafc;
		color: #1d3f9e;
		border: 1px solid #e2e8f0;
		border-radius: 10px;
		font-weight: 600;
		font-size: 0.95rem;
		text-decoration: none;
		transition: all 0.15s ease;
	}

	.btn-secondary:hover {
		background-color: #f1f5f9;
		border-color: #cbd5e1;
	}

	.quick-links-section {
		border-top: 1px solid #f1f5f9;
		padding-top: 2rem;
	}

	.quick-links-heading {
		font-size: 0.875rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--color-text-muted);
		margin: 0 0 1rem 0;
	}

	.quick-links-grid {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		justify-content: center;
	}

	.category-link {
		display: inline-flex;
		align-items: center;
		padding: 0.35rem 0.85rem;
		background-color: #f1f5f9;
		color: #334155;
		border-radius: 9999px;
		font-size: 0.825rem;
		font-weight: 500;
		text-decoration: none;
		transition: all 0.15s ease;
	}

	.category-link:hover {
		background-color: #e2e8f0;
		color: #0f172a;
	}
</style>
