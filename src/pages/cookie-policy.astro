---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Cookie Policy | PanBloom.com"
	description="PanBloom.com Cookie Policy: How we use essential, analytics, and advertising cookies."
>
	<div class="policy-page">
		<div class="container policy-container">
			<header class="policy-header">
				<span class="policy-eyebrow">Cookies &amp; Tracking</span>
				<h1 class="policy-title">Cookie Policy</h1>
				<p class="policy-meta">Last Updated: September 2026 &bull; AdSense Compliance</p>
			</header>

			<div class="policy-content">
				<section>
					<h2>What Are Cookies?</h2>
					<p>
						Cookies are small text files placed on your computer or mobile device when you access websites. They allow our site to remember your preferences and deliver tailored content and advertising.
					</p>
				</section>

				<section>
					<h2>Categories of Cookies We Use</h2>
					<ul>
						<li><strong>Strictly Necessary:</strong> Essential for page navigation and core security features.</li>
						<li><strong>Performance &amp; Analytics:</strong> Anonymized metrics to understand reader traffic patterns and popular articles.</li>
						<li><strong>Advertising Cookies (Google AdSense):</strong> Used by Google and third-party advertising networks to serve relevant advertisements and measure ad performance.</li>
					</ul>
				</section>

				<section>
					<h2>Managing Cookies</h2>
					<p>
						You can configure your browser to reject all or some browser cookies, or to alert you when websites set or access cookies. Note that disabling certain cookies may affect site presentation.
					</p>
				</section>
			</div>
		</div>
	</div>
</BaseLayout>

<style>
	.policy-page {
		padding: 3.5rem 0 5rem;
	}
	.policy-container {
		max-width: 820px;
	}
	.policy-header {
		margin-bottom: 2.5rem;
		border-bottom: 1px solid var(--color-border);
		padding-bottom: 1.5rem;
	}
	.policy-eyebrow {
		font-size: 0.8125rem;
		font-weight: 700;
		color: var(--color-blue-primary);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		display: block;
		margin-bottom: 0.5rem;
	}
	.policy-title {
		font-size: 2.5rem;
		color: var(--color-text-dark);
		line-height: 1.2;
		margin: 0 0 0.75rem 0;
	}
	.policy-meta {
		color: var(--color-text-muted);
		font-size: 0.875rem;
		margin: 0;
	}
	.policy-content {
		color: #334155;
		font-size: 1.05rem;
		line-height: 1.75;
	}
	.policy-content section {
		margin-bottom: 2rem;
	}
	.policy-content h2 {
		font-size: 1.5rem;
		color: var(--color-text-dark);
		margin: 1.75rem 0 0.75rem 0;
	}
	.policy-content p {
		margin-bottom: 1.25rem;
	}
	.policy-content ul {
		margin-bottom: 1.5rem;
		padding-left: 1.5rem;
	}
	.policy-content li {
		margin-bottom: 0.5rem;
	}
</style>
